\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{estilo/vanguarda44}[2026/07/13 Estilo Vanguarda 44]

% Nota: o pacote babel com suporte a portugues/brazilian nao esta disponivel
% neste ambiente de compilacao (falta o pacote babel-portuges do CTAN).
% Usamos apenas inputenc/fontenc para acentuacao; a hifenizacao correta em
% portugues pode ser adicionada depois instalando babel-portuges via tlmgr.
\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}
\RequirePackage[a4paper,margin=2.4cm]{geometry}
\RequirePackage{xcolor}
\RequirePackage{booktabs}
\RequirePackage{longtable}
\RequirePackage{array}
\RequirePackage{enumitem}
\RequirePackage{titlesec}
\RequirePackage{tcolorbox}
\tcbuselibrary{skins,breakable}
\RequirePackage{hyperref}
\RequirePackage{fancyhdr}
\RequirePackage{graphicx}
\RequirePackage{eso-pic}

% Cores tematicas (paleta militar; os nomes antigos (vinho, mostarda, laranja,
% cinzachumbo, papel) viram apelidos da paleta nova via \colorlet, entao o
% resto do livro continua funcionando sem precisar trocar nome de cor em
% cada arquivo)
\definecolor{verdeoliva}{HTML}{4B5320}
\definecolor{caqui}{HTML}{B7A160}
\definecolor{ferrugem}{HTML}{8B5A2B}
\definecolor{tintaguerra}{HTML}{2B2A22}
\definecolor{papelenvelhecido}{HTML}{FAF7EE}

\colorlet{vinho}{verdeoliva}
\colorlet{mostarda}{caqui}
\colorlet{laranja}{ferrugem}
\colorlet{cinzachumbo}{tintaguerra}
\colorlet{papel}{papelenvelhecido}

% Fundo de pagina: cor base + textura de papel envelhecido (so nos
% documentos de prosa; os cartoes usam estilo/cartoes.sty, que nao carrega
% isto)
\pagecolor{papelenvelhecido}
\AddToShipoutPictureBG{%
  \AtPageLowerLeft{%
    \includegraphics[width=\paperwidth,height=\paperheight]{estilo/textura_pagina.jpg}%
  }%
}

% Formatacao de titulos de Parte / Secao
\titleformat{\part}[block]
  {\clearpage\centering\bfseries\color{vinho}\Huge}
  {\color{mostarda}\Large PARTE \thepart\\[6pt]}
  {0pt}
  {}
\titleformat{\section}
  {\bfseries\color{vinho}\Large}
  {\thesection}
  {8pt}
  {}
\titleformat{\subsection}
  {\bfseries\color{cinzachumbo}\large}
  {\thesubsection}
  {6pt}
  {}
\titleformat{\subsubsection}
  {\bfseries\color{cinzachumbo}\normalsize}
  {\thesubsubsection}
  {6pt}
  {}

\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\color{cinzachumbo}Vanguarda 44: O Wargame - Livro de Regras}
\fancyhead[R]{\small\color{cinzachumbo}\thepage}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0.4pt}

% Caixa de "Nota" reutilizada em todo o livro
\newtcolorbox{nota}{
  breakable,
  colback=papel,
  colframe=mostarda,
  coltitle=tintaguerra,
  colbacktitle=caqui,
  boxrule=0.6pt,
  arc=1pt,
  left=6pt,right=6pt,top=4pt,bottom=4pt,
  fonttitle=\bfseries,
  title=Nota
}

\newcommand{\vsection}[1]{\section{#1}}

\hypersetup{
  colorlinks=true,
  linkcolor=vinho,
  citecolor=vinho,
  urlcolor=vinho,
  pdftitle={Vanguarda 44: O Wargame - Livro de Regras},
  pdfauthor={Felipe Ramires Terrazas}
}

